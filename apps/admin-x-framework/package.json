{
  "name": "@tryghost/admin-x-framework",
  "version": "0.0.0",
  "private": true,
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost/tree/main/apps/admin-x-framework",
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "source": "./src/errors.ts",
      "types": "./types/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./helpers": {
      "source": "./src/helpers.ts",
      "types": "./types/helpers.d.ts",
      "import": "./dist/helpers.js",
      "require": "./dist/helpers.cjs"
    },
    "./hooks": {
      "source": "./src/hooks.ts",
      "types": "./types/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./api/*": {
      "source": "./src/api/*.ts",
      "types": "./types/api/*.d.ts",
      "import": "./dist/api/*.js",
      "require": "./dist/api/*.cjs"
    },
    "./utils/post-utils": {
      "source": "./src/utils/post-utils.ts",
      "types": "./types/utils/post-utils.d.ts",
      "import": "./dist/utils/post-utils.js",
      "require": "./dist/utils/post-utils.cjs"
    },
    "./utils/recipient-filter": {
      "source": "./src/utils/recipient-filter.ts",
      "types": "./types/utils/recipient-filter.d.ts",
      "import": "./dist/utils/recipient-filter.js",
      "require": "./dist/utils/recipient-filter.cjs"
    },
    "./utils/admin-theme": {
      "source": "./src/utils/admin-theme.ts",
      "types": "./types/utils/admin-theme.d.ts",
      "import": "./dist/utils/admin-theme.js",
      "require": "./dist/utils/admin-theme.cjs"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.declaration.json && vite build"
  },
  "dependencies": {
    "@sentry/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tryghost/limit-service": "workspace:*",
    "@tryghost/nql-string": "workspace:*",
    "@tryghost/shade": "workspace:*",
    "@tryghost/string": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "glob": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/admin-x-framework",
          "command": "vite build --watch"
        },
        "dependsOn": [
          "build"
        ]
      },
      "build": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
