{
  "name": "@tryghost/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && pnpm assemble:assets",
    "typecheck": "tsc -b",
    "assemble:assets": "node ../../scripts/assemble-admin-assets.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/theme-one-dark": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@radix-ui/react-focus-guards": "catalog:",
    "@radix-ui/react-focus-scope": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@tryghost/admin-x-framework": "workspace:*",
    "@tryghost/color-utils": "catalog:",
    "@tryghost/custom-fonts": "catalog:",
    "@tryghost/i18n": "workspace:*",
    "@tryghost/kg-clean-basic-html": "workspace:*",
    "@tryghost/kg-converters": "workspace:*",
    "@tryghost/kg-unsplash-selector": "workspace:*",
    "@tryghost/koenig-lexical": "workspace:*",
    "@tryghost/nql": "catalog:",
    "@tryghost/nql-lang": "catalog:",
    "@tryghost/nql-string": "workspace:*",
    "@tryghost/shade": "workspace:*",
    "@tryghost/string": "catalog:",
    "@tryghost/timezone-data": "catalog:",
    "@uiw/react-codemirror": "catalog:",
    "clsx": "catalog:",
    "dequal": "catalog:",
    "dompurify": "catalog:",
    "flexsearch": "catalog:",
    "jszip": "3.10.1",
    "lucide-react": "catalog:",
    "luxon": "catalog:",
    "mingo": "catalog:",
    "moment-timezone": "catalog:",
    "papaparse": "5.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "semver": "catalog:",
    "sonner": "catalog:",
    "use-debounce": "10.1.1",
    "validator": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/papaparse": "5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "@types/validator": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:"
  },
  "nx": {
    "namedInputs": {
      "cardAssets": [
        "{workspaceRoot}/ghost/core/core/frontend/src/cards/**/*"
      ]
    },
    "implicitDependencies": [
      "@internal/scripts"
    ],
    "targets": {
      "build": {
        "inputs": [
          {
            "env": "GHOST_CDN_URL"
          },
          "default",
          "cardAssets",
          "^default"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{workspaceRoot}/ghost/core/core/built/admin",
          "{workspaceRoot}/ghost/core/core/built/embed-renderer"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "assemble:assets": {
        "cache": false,
        "outputs": [
          "{projectRoot}/dist",
          "{workspaceRoot}/ghost/core/core/built/admin",
          "{workspaceRoot}/ghost/core/core/built/embed-renderer"
        ]
      }
    }
  }
}
