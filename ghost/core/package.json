{
  "name": "ghost",
  "version": "6.70.0-rc.0",
  "description": "The professional publishing platform",
  "keywords": [
    "blog",
    "cms",
    "content",
    "ghost",
    "headless",
    "markdown"
  ],
  "homepage": "https://ghost.org",
  "bugs": "https://github.com/TryGhost/Ghost/issues",
  "license": "MIT",
  "author": "Ghost Foundation",
  "contributors": "https://github.com/TryGhost/Ghost/graphs/contributors",
  "repository": {
    "type": "git",
    "url": "git://github.com/TryGhost/Ghost.git"
  },
  "files": [
    "core/",
    "!core/built/**/*.map",
    "!core/built/**/test-*",
    "!core/built/**/tests-*",
    "content/*/README.md",
    "content/themes/casper/",
    "!content/themes/casper/pnpm-lock.yaml",
    "content/themes/source/",
    "!content/themes/source/pnpm-lock.yaml",
    "bin/",
    "types/",
    "index.js",
    "loggingrc.js",
    "MigratorConfig.js",
    "nodemon.json",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "nodemon index.js",
    "start": "NODE_ENV=production node --conditions=source --import=tsx index.js",
    "build:assets": "pnpm run '/^build:assets:/'",
    "build:assets:cards": "node scripts/build-card-assets.mts",
    "build:assets:css": "postcss core/frontend/public/ghost.css --no-map --use cssnano -o core/frontend/public/ghost.min.css",
    "build:tsc": "tsc"
  },
