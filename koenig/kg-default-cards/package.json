{
  "name": "@tryghost/kg-default-cards",
  "version": "10.3.7",
  "description": "Mobiledoc card definitions for Ghost's editor",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/Ghost.git",
    "directory": "koenig/kg-default-cards"
  },
  "files": [
    "LICENSE",
    "README.md",
    "build"
  ],
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "echo \"Implement me!\"",
    "build": "tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"module\"}' > build/esm/package.json"
  },
  "dependencies": {
    "@tryghost/kg-markdown-html-renderer": "workspace:~",
    "@tryghost/kg-utils": "workspace:~",
    "@tryghost/string": "catalog:",
    "@tryghost/url-utils": "catalog:",
    "handlebars": "4.7.9",
    "juice": "catalog:",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "simple-dom": "1.4.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.13.1 || ^24.0.0"
  }
}
