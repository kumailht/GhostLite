{
  "name": "@tryghost/i18n",
  "version": "0.0.0",
  "private": true,
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost/tree/main/packages/i18n",
  "files": [
    "build",
    "locales"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./registry/ghost": {
      "source": "./src/registry/ghost.ts",
      "types": "./build/registry/ghost.d.ts",
      "default": "./build/registry/ghost.js"
    },
    "./locale-data.json": {
      "source": "./src/locale-data.json",
      "types": "./src/locale-data.json",
      "default": "./build/locale-data.json"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "translate": "pnpm translate:ghost && node generate-context.js",
    "translate:ghost": "NAMESPACE=ghost i18next '../../ghost/core/core/{frontend,server,shared}/**/*.{js,jsx,ts}' '!../../ghost/core/core/frontend/public/*.min.js' '../../ghost/core/core/server/lib/email-rendering/partials/**/*.hbs' '../../ghost/core/core/server/services/email-service/email-templates/**/*.hbs' '../../ghost/core/core/server/services/comments/email-templates/**/*.hbs' '../../ghost/core/core/server/services/member-welcome-emails/email-templates/**/*.hbs' '../../ghost/core/core/server/services/gifts/**/*.{ts,hbs}'"
  },
  "dependencies": {
    "@tryghost/debug": "catalog:",
    "i18next": "23.16.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "glob": "catalog:",
    "i18next-parser": "9.4.0",
    "typescript": "catalog:"
  },
  "ghostPackage": {
    "goldenPath": "exempt",
    "reason": "Ships 3.5MB of runtime locale JSON that tsc cannot emit into build/, so files cannot be limited to [\"build\"]."
  },
  "nx": {
    "tags": [
      "i18n"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build"
        ]
      }
    }
  }
}
