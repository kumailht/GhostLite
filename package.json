{
  "name": "ghost-monorepo",
  "version": "0.0.0-private",
  "private": true,
  "description": "The professional publishing platform",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost",
  "scripts": {
    "dev": "pnpm build:admin && pnpm --filter ghost dev",
    "build:admin": "pnpm nx run ghost:build:assets && pnpm nx run @tryghost/admin:build",
    "archive": "pnpm nx run ghost:archive",
    "build:production": "pnpm nx run ghost:build:tsc && pnpm nx run ghost:build:assets && pnpm nx run @tryghost/admin:build",
    "build": "pnpm nx run-many -t build",
    "build:clean": "nx reset && rimraf -g 'ghost/*/build' && rimraf -g 'ghost/*/tsconfig.tsbuildinfo'",
    "clean:hard": "node ./scripts/clean.js",
    "fix": "pnpm store prune && rimraf -g '**/node_modules' && pnpm install && pnpm nx reset",
    "create-package": "node ./scripts/create-package.js",
    "knex-migrator": "pnpm --filter ghost run knex-migrator",
    "bootstrap": "pnpm install && git submodule update --init --recursive && git config --local blame.ignoreRevsFile .git-blame-ignore-revs",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files=false",
    "lint": "pnpm nx run-many -t lint lint:boundaries && pnpm lint:packages && pnpm lint:versioning && pnpm lint:docs",
    "lint:agent-guidance": "node scripts/check-agent-guidance.js",
    "lint:agent-skills": "node scripts/check-agent-skill-links.js",
    "lint:doc-links": "git ls-files -z '*.md' ':(exclude,glob)**/fixture/**' ':(exclude,glob)**/fixtures/**' | xargs -0 remark --use remark-validate-links --frail --quiet",
    "lint:markdown": "git ls-files -z '*.md' ':(exclude,glob)**/fixture/**' ':(exclude,glob)**/fixtures/**' | xargs -0 markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "lint:boundaries": "depcruise ghost/core/core apps --config .dependency-cruiser.cjs",
    "lint:packages": "node scripts/check-internal-packages.js",
    "lint:versioning": "node scripts/check-versioning-ignore.js",
    "lint:docs": "pnpm lint:agent-skills && pnpm lint:agent-guidance && pnpm lint:markdown && pnpm lint:doc-links",
    "format": "node scripts/format.js",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm test",
    "test": "pnpm nx run-many -t test --exclude ghost-admin",
    "test:types": "pnpm nx run-many -t test:types",
    "test:unit": "pnpm nx run-many -t test:unit",
    "test:watch": "vitest",
    "preinstall": "node ./scripts/enforce-package-manager.js",
    "query-parameter-policy:export": "pnpm --filter ghost query-parameter-policy:export",
    "release": "node scripts/release.js",
    "inventory:typescript": "node scripts/typescript-inventory.ts"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-pattern": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "nx": "23.2.0",
    "oxfmt": "catalog:",
    "remark-cli": "catalog:",
    "remark-validate-links": "catalog:",
    "rimraf": "6.1.3",
    "secretlint": "catalog:",
    "shell-quote": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "eslintIgnore": [
    "**/node_modules/**"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.23.1 || ^24.20.0"
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11",
  "monorepo": {
    "public": false,
    "internalPackages": true,
    "repo": "https://github.com/TryGhost/Ghost",
    "scope": "@tryghost"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "lint:boundaries": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/.dependency-cruiser.cjs",
          "{workspaceRoot}/ghost/core/core/**/*",
          "{workspaceRoot}/apps/**/*",
          "sharedGlobals"
        ],
        "outputs": [],
        "options": {
          "command": "depcruise ghost/core/core apps --config .dependency-cruiser.cjs"
        }
      }
    }
  }
}
