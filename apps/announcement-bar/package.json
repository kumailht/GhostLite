{
  "name": "@tryghost/announcement-bar",
  "version": "1.1.28",
  "description": "Announcement banner for Ghost sites",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost",
  "files": [
    "umd/",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "preship": "pnpm lint",
    "ship": "node ../../scripts/release-apps.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "preact": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-vite-public-app": "workspace:*",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/announcement-bar",
          "command": "vite build --watch --mode development"
        }
      }
    },
    "tags": [
      "public-app",
      "playwright"
    ]
  }
}
