{
  "name": "ghost-monorepo",
  "version": "0.0.0-private",
  "private": true,
  "description": "A lightweight, blogging-only fork of Ghost",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": "https://github.com/TryGhost/Ghost",
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "bootstrap": "pnpm install && git submodule update --init --recursive",
    "fetch-themes": "node scripts/fetch-themes.js",
    "dev": "pnpm build && pnpm --filter ghost dev",
    "start": "pnpm --filter ghost start",
    "build": "pnpm nx run ghost:build:assets && pnpm nx run @tryghost/admin:build",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "nx": "23.2.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.23.1 || ^24.20.0"
  }
}
