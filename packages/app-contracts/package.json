{
  "name": "@tryghost/app-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The contracts between Ghost and apps: formats, types and validation shared by Ghost core and admin",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/Ghost.git",
    "directory": "packages/app-contracts"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./manifest": {
      "source": "./src/manifest/index.ts",
      "types": "./build/manifest/index.d.ts",
      "default": "./build/manifest/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@internal/cfg-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  },
  "ghostPackage": {
    "goldenPath": "compliant"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build"
        ]
      }
    }
  }
}
